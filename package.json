{
  "name": "ai-stack",
  "version": "1.0.0",
  "description": "CLI tool to bootstrap AI and development workflow tools for any new project.",
  "type": "module",
  "bin": {
    "ai-stack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "ai",
    "developer-tools",
    "scaffolding"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.17.0 <21 || >=22.13.0 <23 || >=23.5.0"
  }
}
